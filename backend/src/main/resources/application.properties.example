# Copia este archivo como application.properties (o application-local.properties)
# y ajusta los valores. application-local.properties ya esta ignorado por Git.

spring.datasource.url=jdbc:postgresql://localhost:5432/sakura_store
spring.datasource.username=postgres
spring.datasource.password=postgres

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

server.port=8080
